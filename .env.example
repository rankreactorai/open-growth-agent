# Per-project API key from the RankReactor dashboard sidebar → API Key.
# Format: rr_live_…
# Create / regenerate / revoke there. The full key is shown once.
# Docs: https://www.rankreactor.ai/docs/ai-assistants
RANKREACTOR_API_KEY=

# Hosted MCP server (Streamable HTTP). Do not change unless you know why.
RANKREACTOR_MCP_URL=https://www.rankreactor.ai/mcp

# Light UI listen port (local + Docker).
PORT=3000
